<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_estate_property_form" model="ir.ui.view">
    <field name="name">estate.property.form</field>
    <field name="model">estate.property</field>
    <field name="arch" type="xml">
        <form string="Property">
            <header>
    <button name="action_sold" type="object" string="Sold" invisible="state in ('sold', 'cancelled')" class="oe_highlight"/>
    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('sold', 'cancelled')"/>
    <field name="state" widget="statusbar" statusbar_visible="new,offer_received,offer_accepted,sold"/>
</header>
            <sheet>
                <group>
                    <group>
                        <field name="name"/>
                        <field name="property_type_id"/>
                        <field name="postcode"/>
                        <field name="date_availability"/>
                    </group>
                    <group>
                        <field name="expected_price"/>
                        <field name="selling_price"/>
                        <field name="bedrooms"/>
                        <field name="living_area"/>
                        <field name="facades"/>
                        <field name="garage"/>
                    </group>
                </group>
                <notebook>
                    <page string="Description" name="description">
                        <group>
                            <field name="description"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="total_area" readonly="1"/>
                            <field name="garden"/>
                            <field name="garden_area"/>
                            <field name="garden_orientation"/>
                        </group>
                    </page>
                    <page string="Other Info">
                        <group>
                            <field name="salesperson_id"/>
                            <field name="buyer_id"/>
                            <field name="best_price" readonly="1"/>
                        </group>
                       <field name="offer_ids">
    <list editable="bottom">
        <field name="price"/>
        <field name="partner_id"/>
        <field name="status"/>
    </list>
</field>
                    </page>
                </notebook>
            </sheet>
        </form>
    </field>
</record>
    <menuitem id="estate_menu_root" name="Real Estate"/>
</odoo>